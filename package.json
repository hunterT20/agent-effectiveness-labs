{
  "name": "agent-effectiveness-labs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --check \"*.{json,md,mjs,js,yml,yaml}\" \"packages/**/*.{json,ts}\" \".github/**/*.yml\"",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@ael/cli": "workspace:*",
    "@ael/core": "workspace:*",
    "@ael/reporter": "workspace:*",
    "@ael/runtime": "workspace:*",
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
