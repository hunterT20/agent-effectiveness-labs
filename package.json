{
  "name": "agent-effectiveness-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --check \"*.{json,md,mjs,js,yml,yaml}\" \"docs/*.md\" \"docs/adr/*.md\" \"packages/**/*.{json,ts}\" \".github/**/*.yml\" \".changeset/*.{md,json}\"",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "knip": "knip",
    "publint": "pnpm -r exec publint --strict",
    "verify": "pnpm format && pnpm build && pnpm lint && pnpm test:coverage && pnpm knip && pnpm publint",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:synthetic": "node scripts/verify-synthetic.mjs"
  },
  "devDependencies": {
    "@ael/cli": "workspace:*",
    "@ael/core": "workspace:*",
    "@ael/reporter": "workspace:*",
    "@ael/runtime": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "yaml": "^2.7.0"
  }
}
