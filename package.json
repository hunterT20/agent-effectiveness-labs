{
  "name": "agent-effectiveness-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --check \"*.{json,md,mjs,js,yml,yaml}\" \"packages/**/*.{json,ts}\" \".github/**/*.yml\"",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "knip": "knip",
    "publint": "pnpm -r exec publint --strict",
    "verify": "pnpm format && pnpm --filter @ael/core build && pnpm lint && pnpm typecheck && pnpm build && pnpm test:coverage && pnpm knip && pnpm publint",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:synthetic": "node scripts/verify-synthetic.mjs"
  },
  "devDependencies": {
    "@ael/cli": "workspace:*",
    "@ael/core": "workspace:*",
    "@ael/reporter": "workspace:*",
    "@ael/runtime": "workspace:*",
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.21.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.21.0",
    "knip": "^5.41.0",
    "prettier": "^3.5.3",
    "publint": "^0.2.12",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8",
    "yaml": "^2.7.0"
  }
}
