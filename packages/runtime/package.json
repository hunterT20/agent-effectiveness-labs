{
  "name": "@ael/runtime",
  "version": "0.0.0",
  "description": "Agent Effectiveness Labs runtime: isolation providers, agent adapters, seed workspaces, trial runner, hidden grading, telemetry and encrypted artifacts",
  "keywords": [
    "ael",
    "agent-effectiveness-labs",
    "coding-agent",
    "benchmark",
    "sandbox",
    "isolation",
    "cursor-agent",
    "evaluation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hunterT20/agent-effectiveness-labs#readme",
  "bugs": {
    "url": "https://github.com/hunterT20/agent-effectiveness-labs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunterT20/agent-effectiveness-labs.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run --project unit packages/runtime/test"
  },
  "dependencies": {
    "@ael/core": "workspace:*",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  }
}
