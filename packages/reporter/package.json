{
  "name": "@ael/reporter",
  "version": "0.0.0",
  "description": "Agent Effectiveness Labs reporter: deterministic JSON, Markdown, CSV (formula-injection safe) and self-contained HTML views of experiment evidence",
  "keywords": [
    "ael",
    "agent-effectiveness-labs",
    "coding-agent",
    "benchmark",
    "report",
    "markdown",
    "csv",
    "html"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hunterT20/agent-effectiveness-labs#readme",
  "bugs": {
    "url": "https://github.com/hunterT20/agent-effectiveness-labs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunterT20/agent-effectiveness-labs.git",
    "directory": "packages/reporter"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run --project unit packages/reporter/test"
  },
  "dependencies": {
    "@ael/core": "workspace:*"
  }
}
