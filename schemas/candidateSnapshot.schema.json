{
  "$ref": "#/definitions/candidateSnapshot",
  "definitions": {
    "candidateSnapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "baseFingerprint": {
          "type": "string"
        },
        "finalFingerprint": {
          "type": "string"
        },
        "patchSha256": {
          "type": "string"
        },
        "fileManifestSha256": {
          "type": "string"
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "changeType": {
                "type": "string",
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed"
                ]
              },
              "oldPath": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "changeType"
            ],
            "additionalProperties": false
          }
        },
        "patchArtifact": {
          "type": "string"
        },
        "untrackedArchiveArtifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "overlayIntegrity": {
          "type": "string",
          "enum": [
            "unchanged",
            "tampered"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "baseFingerprint",
        "finalFingerprint",
        "patchSha256",
        "fileManifestSha256",
        "changedFiles",
        "patchArtifact",
        "untrackedArchiveArtifact",
        "overlayIntegrity"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
