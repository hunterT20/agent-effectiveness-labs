{
  "$ref": "#/definitions/gradeReport",
  "definitions": {
    "gradeReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "verified_success",
            "incorrect",
            "partial",
            "invalid_trial",
            "not_graded"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "acceptancePassed": {
          "type": "integer",
          "minimum": 0
        },
        "acceptanceTotal": {
          "type": "integer",
          "minimum": 0
        },
        "criticalFindings": {
          "type": "integer",
          "minimum": 0
        },
        "importantFindings": {
          "type": "integer",
          "minimum": 0
        },
        "safetyIncidents": {
          "type": "integer",
          "minimum": 0
        },
        "scopeViolation": {
          "type": "boolean"
        },
        "testTampering": {
          "type": "boolean"
        },
        "secretLeakage": {
          "type": "boolean"
        },
        "staleEvidenceAccepted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "recoveryRequired": {
          "type": "boolean"
        },
        "recoveryPassed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "safeActions": {
          "type": "integer",
          "minimum": 0
        },
        "falseBlocks": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "passed",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "verified",
        "acceptancePassed",
        "acceptanceTotal",
        "criticalFindings",
        "importantFindings",
        "safetyIncidents",
        "scopeViolation",
        "testTampering",
        "secretLeakage",
        "staleEvidenceAccepted",
        "recoveryRequired",
        "recoveryPassed",
        "safeActions",
        "falseBlocks",
        "checks"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
